# Copy to .env.local  (Next.js and Hardhat both read it)

# ---------------------------------------------------------------------------
# Server-side only: NEVER prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Deployer / admin key for Avalanche Fuji. Use a dedicated test wallet, never a mainnet wallet.
# Do not add PRIVATE_KEY to your hosting provider (Vercel) - it is only needed for `npm run deploy:fuji`.
PRIVATE_KEY=
# Optional: a private Fuji RPC endpoint for deploys
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Organization profile of the deployer (shown as organizer name on its events)
ADMIN_ORG_NAME=onCV
ADMIN_ORG_DOMAIN=oncv.xyz
# Delay of the two-step admin handover (npm run admin:transfer), in seconds. 86400 = 1 day.
ADMIN_TRANSFER_DELAY_SECONDS=86400
# Optional: extra wallets verified as organizers during deploy (comma separated)
ORGANIZER_ADDRESSES=
# Project tracking checkpoint spacing in seconds. 7776000 = 90 days (3rd / 6th month).
# For a live demo use e.g. 120 so the "3rd month" checkpoint opens after ~1 minute.
CHECKPOINT_INTERVAL_SECONDS=7776000

# Gasless check-in relayer: a SEPARATE wallet funded with a little Fuji AVAX. It pays attendees' gas.
# Set this on the server (e.g. Vercel env) together with NEXT_PUBLIC_GASLESS_CHECKIN=true.
# It also relays kiosk check-ins. Health check: GET /api/relay/check-in
RELAYER_PRIVATE_KEY=
# Relayer spending caps. Below the minimum balance / above a cap, clients fall back to a normal transaction.
RELAYER_MIN_BALANCE_AVAX=0.02
RELAYER_MAX_TX_PER_EVENT=500
RELAYER_DAILY_TX_LIMIT=2000
# Self-scan relay requests per minute per IP. Venue Wi-Fi puts every attendee behind one IP, keep it high.
RELAYER_IP_LIMIT_PER_MIN=120

# Optional: shared rate limits / relayer budgets across serverless instances (Upstash Redis REST).
# Without these the counters are kept per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: header set by your proxy that carries the real client IP (e.g. cf-connecting-ip).
# On Vercel x-real-ip is used automatically.
TRUSTED_IP_HEADER=

# Optional: private / paid RPC used by the relayer and by /api/rpc (never exposed to the browser)
RPC_UPSTREAM_URL=

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
# WalletConnect Cloud / Reown project id (free: https://cloud.reown.com).
# Required for OKX Wallet / MetaMask mobile QR connections outside localhost.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# true = attendees sign a free EIP-712 message and the relayer pays the check-in gas
NEXT_PUBLIC_GASLESS_CHECKIN=false
# Optional: override config/deployment.json (written automatically by `npm run deploy:fuji`)
NEXT_PUBLIC_PROOFSKILL_ADDRESS=
NEXT_PUBLIC_PROJECT_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_ADDRESS=
# Optional: RPC used for reads in the browser
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# true = browser reads go through /api/rpc (uses RPC_UPSTREAM_URL, rate limited per IP)
NEXT_PUBLIC_RPC_PROXY=false
# Public HTTPS URL of the deployed app, used in QR codes and share links (phones cannot open localhost).
# Leave empty to use the current origin. Set it to YOUR deployment's URL - a wrong value sends every QR
# scan to another site (the organizer console warns when it differs from the page's origin).
NEXT_PUBLIC_APP_URL=
# Inbox that receives "Request Verification" emails from unverified organizers (default: verify@oncv.xyz)
NEXT_PUBLIC_VERIFICATION_EMAIL=
